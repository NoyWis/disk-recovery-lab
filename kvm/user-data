#cloud-config
hostname: mount-lab
manage_etc_hosts: true

users:
  - name: student
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo
    shell: /bin/bash
    lock_passwd: false

chpasswd:
  list: |
    student:student
    root:root
  expire: false

ssh_pwauth: true
disable_root: false

growpart:
  mode: auto
  devices: ["/"]

package_update: false

runcmd:
  - [ sed, -i, 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/', /etc/ssh/sshd_config ]
  - [ sed, -i, 's/^#\?PermitRootLogin.*/PermitRootLogin yes/', /etc/ssh/sshd_config ]
  - [ systemctl, restart, ssh ]

final_message: "mount-lab cloud-init done"
